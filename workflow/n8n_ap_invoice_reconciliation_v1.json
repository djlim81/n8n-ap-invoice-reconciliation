        -48
      ],
      "id": "a2003382-6f1d-4770-ace2-0baa2413d046",
      "name": "Convert to File"
    },
    {
      "parameters": {
        "jsCode": "\nconst invoices = $input.all().map(item => item.json);\n\nconst received = invoices.length;\n\nconst valid = invoices.filter(\n  invoice => invoice.DataQualityStatus === \"Valid\"\n).length;\n\nconst invalid = invoices.filter(\n  invoice => invoice.DataQualityStatus === \"Invalid\"\n).length;\n\nconst unclassified = received - valid - invalid;\n\nconst countCheck = unclassified === 0\n  ? \"PASS\"\n  : \"FAIL\";\n\nreturn [\n  {\n    json: {\n      ReceivedRows: received,\n      ValidRows: valid,\n      InvalidRows: invalid,\n      UnclassifiedRows: unclassified,\n      CountCheck: countCheck\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -192
      ],
      "id": "e1fc0e88-d5a2-4102-b8ec-1b4e51da1fe0",
      "name": "Batch Intake Control"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2176,
        -208
      ],
      "id": "d81018ba-3380-4e71-9034-9f1d2601d742",
      "name": "Merge Audit Records"
    },
    {
      "parameters": {
        "jsCode": "\n\n\n\n\nconst records = $input.all().map(item => item.json);\n\n\n\n\n\n // Retrieve original validated invoices\nconst sourceRecords = $(\"Validate Imported Invoice Data\")\n  .all()\n  .map(item => item.json);\n\n// Independently calculate expected counts\nconst intake = {\n  ReceivedRows: sourceRecords.length,\n\n  ValidRows: sourceRecords.filter(\n    record => record.DataQualityStatus === \"Valid\"\n  ).length,\n\n  InvalidRows: sourceRecords.filter(\n    record => record.DataQualityStatus === \"Invalid\"\n  ).length,\n\n  CountCheck: sourceRecords.every(\n    record => [\"Valid\", \"Invalid\"].includes(record.DataQualityStatus)\n  ) ? \"PASS\" : \"FAIL\"\n};\n\n\n// Count successfully reconciled invoices\nconst reconciled = records.filter(\n  record =>\n    record.DataQualityStatus === \"Valid\" &&\n    [\"Review Required\", \"Amount Matched\"].includes(record.ReviewStatus)\n).length;\n\n// Count invoices held for data quality\nconst dataQualityHolds = records.filter(\n  record =>\n    record.DataQualityStatus === \"Invalid\" &&\n    record.ReviewStatus === \"Data Quality Hold\"\n).length;\n\n// Identify records with unexpected classifications\nconst unexpected = records.length - reconciled - dataQualityHolds;\n\n\nconst sourceKeys = sourceRecords.map(\n  record => record.SourceRecordKey\n);\n\nconst processedKeys = records.map(\n  record => record.SourceRecordKey\n);\n\nconst missingRecordKeys = sourceKeys.filter(\n  key => !processedKeys.includes(key)\n);\n\nconst duplicateRecordKeys = [...new Set(\n  processedKeys.filter(\n    (key, index) => processedKeys.indexOf(key) !== index\n  )\n)];\n\nconst unexpectedRecordKeys = processedKeys.filter(\n  key => !sourceKeys.includes(key)\n);\n\nconst invalidKeyFound = [...sourceKeys, ...processedKeys].some(\n  key => typeof key !== \"string\" || key.trim() === \"\"\n);\n\nconst sourceKeysUnique =\n  new Set(sourceKeys).size === sourceKeys.length;\n\nconst recordIdentityPassed =\n  missingRecordKeys.length === 0 &&\n  duplicateRecordKeys.length === 0 &&\n  unexpectedRecordKeys.length === 0 &&\n  !invalidKeyFound &&\n  sourceKeysUnique;\n\n\n// Check the actual downstream results\nconst auditPassed =\n  intake.CountCheck === \"PASS\" &&\n  records.length === intake.ReceivedRows &&\n  reconciled === intake.ValidRows &&\n  dataQualityHolds === intake.InvalidRows &&\n  unexpected === 0 && recordIdentityPassed;\n\nreturn [\n  {\n    json: {\n      ReceivedRows: intake.ReceivedRows,\n      ExpectedValidRows: intake.ValidRows,\n      ExpectedInvalidRows: intake.InvalidRows,\n      ActualProcessedRows: records.length,\n      ReconciledRows: reconciled,\n      DataQualityHoldRows: dataQualityHolds,\n      UnexpectedRows: unexpected,\n      AuditStatus: auditPassed ? \"PASS\" : \"FAIL\",\n      \nMissingRecordKeys: missingRecordKeys,\nDuplicateRecordKeys: duplicateRecordKeys,\nUnexpectedRecordKeys: unexpectedRecordKeys,\nRecordIdentityCheck: recordIdentityPassed ? \"PASS\" : \"FAIL\",\n\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -208
      ],
      "id": "5cd79e75-ab37-4d41-8974-4a40d67cb413",
      "name": "Downstream Integrity Check"
    },
    {
      "parameters": {
        "jsCode": "\nconst batchId = String($execution.id);\n\nreturn $input.all().map((item, index) => ({\n  json: {\n    ...item.json,\n    SourceBatchID: batchId,\n    SourceRowNumber: index + 2,\n    SourceRecordKey: `${batchId}:${index + 2}`\n  },\n  pairedItem: { item: index }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "1d9cfe29-44c7-41d6-82db-424f96acfcad",
      "name": "Assign Source Record IDs"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst requiredColumns = [\n  \"InvoiceID\",\n  \"Vendor\",\n  \"InvoiceAmount\",\n  \"POAmount\"\n];\n\n// Collect field names found in extracted records\nconst observedColumns = [\n  ...new Set(items.flatMap(item => Object.keys(item.json)))\n];\n\n// Normalize names to detect common header typos\nconst normalize = name =>\n  name.toLowerCase().replace(/[^a-z0-9]/g, \"\");\n\n// Find incorrectly named required columns\nconst incorrectHeaders = requiredColumns.flatMap(\n  required => observedColumns\n    .filter(found =>\n      found !== required &&\n      normalize(found) === normalize(required)\n    )\n    .map(found => `${found} (expected ${required})`)\n);\n\nif (incorrectHeaders.length > 0) {\n  throw new Error(\n    \"Invalid Excel template. Incorrect column heading: \" +\n    incorrectHeaders.join(\", \") +\n    \". Please correct the workbook and upload again.\"\n  );\n}\n\n// Pass unchanged records to the existing workflow\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "e60c0e1e-86de-410f-b23a-29fbccec3b69",
      "name": "Validate Excel Template"
    }
