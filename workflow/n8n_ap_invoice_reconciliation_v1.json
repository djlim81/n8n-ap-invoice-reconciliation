      "id": "1a5ddafa-d225-470b-b41c-9c1bf4d31b50",
      "name": "Extract Invoice Records"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\n// STEP 1: Count each Vendor + InvoiceID combination\n\nconst invoiceCounts = new Map();\n\nfor (const item of items) {\n  const invoice = item.json;\n\n  const vendor = String(invoice.Vendor ?? \"\")\n    .trim()\n    .toLowerCase();\n\n  const id = String(invoice.InvoiceID ?? \"\")\n    .trim()\n    .toUpperCase();\n\n  // Skip incomplete keys\n  if (!vendor || !id) continue;\n\n  const key = JSON.stringify([vendor, id]);\n\n  invoiceCounts.set(\n    key,\n    (invoiceCounts.get(key) || 0) + 1\n  );\n}\n\n// STEP 2: Validate each invoice\n\nreturn items.map(item => {\n  const invoice = item.json;\n  const issues = [];\n\n  const vendor = String(invoice.Vendor ?? \"\")\n    .trim()\n    .toLowerCase();\n\n  const id = String(invoice.InvoiceID ?? \"\")\n    .trim()\n    .toUpperCase();\n\n  // Check required information\n  if (!id) {\n    issues.push(\"Missing Invoice ID\");\n  }\n\n  if (!vendor) {\n    issues.push(\"Missing Vendor\");\n  }\n\n  // Check financial data types\n  for (const field of [\"InvoiceAmount\", \"POAmount\"]) {\n    if (\n      typeof invoice[field] !== \"number\" ||\n      !Number.isFinite(invoice[field])\n    ) {\n      issues.push(`Invalid ${field}`);\n    }\n  }\n\n  // Check duplicate Vendor + InvoiceID\n  if (vendor && id) {\n    const key = JSON.stringify([vendor, id]);\n\n    if (invoiceCounts.get(key) > 1) {\n      issues.push(\"Duplicate Vendor + InvoiceID\");\n    }\n  }\n\n  // Preserve original invoice data\n  return {\n    json: {\n      ...invoice,\n      DataQualityStatus:\n        issues.length === 0 ? \"Valid\" : \"Invalid\",\n      DataQualityIssues: issues.join(\"; \")\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
