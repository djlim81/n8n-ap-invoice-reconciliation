    {
      "parameters": {
        "jsCode": "\nconst invoices = $input.all().map(item => item.json);\n\nconst reviewRequired = invoices.filter(\n  invoice => invoice.ReviewStatus === \"Review Required\"\n);\n\nconst amountMatched = invoices.filter(\n  invoice => invoice.ReviewStatus === \"Amount Matched\"\n);\n\nconst invoiceTotal = invoices.reduce(\n  (sum, invoice) => sum + invoice.InvoiceAmount, 0\n);\n\nconst poTotal = invoices.reduce(\n  (sum, invoice) => sum + invoice.POAmount, 0\n);\n\nconst netDifference = invoices.reduce(\n  (sum, invoice) => sum + invoice.Difference, 0\n);\n\nconst absoluteDifference = invoices.reduce(\n  (sum, invoice) => sum + Math.abs(invoice.Difference), 0\n);\n\nconst exceptionRate = invoices.length > 0\n  ? (reviewRequired.length / invoices.length) * 100\n  : 0;\n\nreturn [\n  {\n    json: {\n      TotalInvoices: invoices.length,\n      ReviewRequired: reviewRequired.length,\n      AmountMatched: amountMatched.length,\n      InvoiceTotal: invoiceTotal,\n      POTotal: poTotal,\n      NetDifference: netDifference,\n      AbsoluteDifference: absoluteDifference,\n      ExceptionRatePct: exceptionRate\n    }\n  }\n];\n"
      },
